{
	"name": "@superbmeteor/lucide-foundry",
	"version": "0.4.0",
	"private": true,
	"description": "Lucide icons and Lucide lab icons as pen.dev component libraries and a Swift package, drawn as filled outlines",
	"keywords": [
		"icons",
		"lucide",
		"pen",
		"pen.dev",
		"swift"
	],
	"license": "MIT AND ISC",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/superbmeteor/lucide-foundry.git"
	},
	"bin": {
		"lucide-foundry": "cli/lucide-foundry.js"
	},
	"files": [
		"cli/lucide-foundry.js",
		"dist",
		"LICENSE",
		"LICENSE-LUCIDE"
	],
	"scripts": {
		"generate": "bun tools/generate.ts",
		"generate:check": "bun tools/generate.ts --check",
		"link:check": "bun cli/lucide-foundry.js link --check examples",
		"update": "bun tools/update.ts",
		"swift:test": "swift build && swift test && xcodebuild test -quiet -scheme LucideFoundry-Package -destination platform=macOS",
		"format": "oxfmt --ignore-path .gitignore --ignore-path .oxfmtignore .",
		"format:check": "oxfmt --check --ignore-path .gitignore --ignore-path .oxfmtignore .",
		"lint": "oxlint --deny-warnings",
		"typecheck": "tsc",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run generate:check && bun run link:check",
		"hooks:install": "lefthook install"
	},
	"devDependencies": {
		"@lucide/lab": "0.17.0",
		"@types/bun": "1.4.4",
		"canvaskit-wasm": "0.42.0",
		"lefthook": "2.1.16",
		"lucide-static": "1.77.0",
		"oxfmt": "0.75.0",
		"oxlint": "1.90.0",
		"typescript": "7.0.2"
	},
	"engines": {
		"node": ">=22"
	}
}
